# Behind a TLS proxy (Caddy in deploy/) keep the scheme the browser used, so URLs built by the API stay https.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# Per-client limits for a public instance: writes and R maps cost CPU, reads of stored data stay unlimited.
# Requests with an empty key are not counted, so the write zone only sees POST/PUT/PATCH/DELETE.
map $request_method $write_client {
    GET     '';
    HEAD    '';
    OPTIONS '';
    default $binary_remote_addr;
}
limit_req_zone $write_client zone=writes:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=maps:10m rate=60r/m;
limit_req_status 429;

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Filled in at startup with the container's DNS server, so a recreated backend is found again.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # Client address from a reverse proxy on the container network (Caddy, Podman/Docker gateway).
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    # Inherited by every location below; $http_host keeps the port, so Location headers point back here.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;

    # Same origin for the SPA and the API, so the browser needs no CORS.
    location /api/ {
        limit_req zone=writes burst=10 nodelay;
        set $backend http://backend:8080;
        proxy_pass $backend;
        client_max_body_size 10m;
    }

    # Each R map interpolates a national grid.
    location /api/erosivity-maps {
        limit_req zone=writes burst=10 nodelay;
        limit_req zone=maps burst=20 nodelay;
        set $backend http://backend:8080;
        proxy_pass $backend;
    }

    # INMET yearly ZIPs; the backend queues them, so no long proxy timeout is needed.
    location /api/imports/archives {
        limit_req zone=writes burst=10 nodelay;
        set $backend http://backend:8080;
        proxy_pass $backend;
        client_max_body_size 512m;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
