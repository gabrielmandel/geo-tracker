# Copy to .env next to docker-compose.prod.yml and fill in. Never commit the real .env.

# Public host name pointing (A record) to the VM. Free options: a DuckDNS subdomain (name.duckdns.org)
# or the IP-based name <ip-with-dashes>.sslip.io.
DOMAIN=geo.example.org
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=you@example.org

# GitHub user or organization that publishes the images (ghcr.io/<owner>/geo-tracker-*), in lowercase.
GHCR_OWNER=gabrielmandel
# "latest" = last release tag; "edge" = main branch; or a version such as 1.0.0.
TAG=latest

DB_NAME=geotracker
DB_USER=geotracker
# Generate with: openssl rand -base64 24
DB_PASSWORD=change-me

# Required (X-Admin-Token header) for imports, cache refreshes and INMET syncs. Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me

# Weekly download of the current INMET year (Mondays 04:00 UTC).
INMET_SYNC_ENABLED=true

# Daily database dumps kept in ./backups.
BACKUP_KEEP_DAYS=3
